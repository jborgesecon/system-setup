# Ansible-managed — do not edit manually
# {{ ansible_managed }}


# ===== history settings =====
HISTSIZE=10000
SAVEHIST=10000
HISTFILE="{{ zsh_history_path }}"

# History options
setopt HIST_VERIFY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt INC_APPEND_HISTORY

# ===== zinit =====
ZINIT_HOME="{{ zsh_zinit_dir }}"
source "${ZINIT_HOME}/zinit.zsh"

# ===== completions =====
autoload -U compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# ===== powerlevel10k =====
zinit ice depth=1; zinit light {{ zsh_p10k_theme }}

# ===== plugins =====
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

# ===== keybindings =====
# Make Home, End, PageUp, PageDown, Delete, and Ctrl+Arrows work properly
bindkey '^[[H' beginning-of-line       # Home
bindkey '^[[F' end-of-line             # End
bindkey '^[[3~' delete-char            # Delete
bindkey '^[[1~' beginning-of-line      # Home (alternate)
bindkey '^[[4~' end-of-line            # End (alternate)
bindkey '^[OH' beginning-of-line       # Home (alternative mode)
bindkey '^[OF' end-of-line             # End (alternative mode)
bindkey '^[[5~' up-line-or-history     # PageUp
bindkey '^[[6~' down-line-or-history   # PageDown

# Ctrl+Left / Ctrl+Right to move word-by-word
bindkey '^[[1;5D' backward-word        # Ctrl+Left
bindkey '^[[1;5C' forward-word         # Ctrl+Right

# Load terminfo for additional robustness
zmodload zsh/terminfo
[[ -n "${terminfo[khome]}" ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n "${terminfo[kend]}" ]] && bindkey "${terminfo[kend]}" end-of-line
[[ -n "${terminfo[kdch1]}" ]] && bindkey "${terminfo[kdch1]}" delete-char
[[ -n "${terminfo[kpp]}" ]] && bindkey "${terminfo[kpp]}" up-line-or-history
[[ -n "${terminfo[knp]}" ]] && bindkey "${terminfo[knp]}" down-line-or-history

# ===== plugin configurations =====
# Enable command suggestions from the completion engine as a fallback for history
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# p10k wizard output lives below — added on first terminal open
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
