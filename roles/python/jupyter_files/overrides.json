{
  "@jupyterlab/notebook-extension:tracker": {
    "autoStartDefaultKernel": true
  },
  "@jupyterlab/apputils-extension:themes": {
    "theme": "JupyterLab Dark"
  },
  "@jupyter-lsp/jupyterlab-lsp:completion": {
    "continuousHinting": true,
    "suppressContinuousHintingIn": [
      "Comment",
      "BlockComment",
      "LineComment",
      "String"
    ],
    "suppressTriggerCharacterIn": [
      "Comment",
      "BlockComment",
      "LineComment",
      "String"
    ],
    "waitForBusyKernel": true,
    "theme": "vscode",
    "kernelCompletionsFirst": false,
    "caseSensitive": true,
    "includePerfectMatches": true,
    "preFilterMatches": true,
    "labelExtra": "auto",
    "layout": "side-by-side",
    "typesMap": {
      "<unknown>": "Kernel",
      "instance": "Value",
      "path": "File",
      "param": "Variable",
      "missing": "Constant",
      "nothing": "Constant",
      "undefinitializer": "Constant",
      "base.devnull": "Constant"
    },
    "disable": false
  },
  "@jupyterlab/shortcuts-extension:shortcuts": {
    "shortcuts": [
      {
        "command": "notebook:restart-run-all",
        "selector": "body",
        "keys": [
          "Alt Shift R"
        ],
        "args": {}
      },
      {
        "command": "notebook:clear-cell-output",
        "selector": "body",
        "keys": [
          "Alt Shift O"
        ],
        "args": {}
      },
      {
        "command": "notebook:clear-all-cell-outputs",
        "selector": "body",
        "keys": [
          "Alt Shift X"
        ],
        "args": {}
      },
      {
        "command": "notebook:create-new",
        "selector": "body",
        "keys": [
          "Alt Shift N"
        ],
        "args": {}
      }
    ]
  },
  "@jupyterlab/completer-extension:manager": {
    "availableProviders": {
      "lsp": 1000,
      "CompletionProvider:context": 500,
      "CompletionProvider:kernel": 550,
      "DebuggerCompletionProvider": 1000
    },
    "providerTimeout": 1000,
    "showDocumentationPanel": false,
    "autoCompletion": true,
    "suppressIfInlineCompleterActive": true
  }
}